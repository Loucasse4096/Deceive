<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Deceive macOS port.

    Original project: github.com/molenzwiebel/Deceive (GPL-3.0, by molenzwiebel).
    This file replaces the original Windows-only build (Microsoft.NET.Sdk.WindowsDesktop,
    net472, WinForms, Costura.Fody) with a cross-platform .NET 8 + Avalonia setup that
    targets macOS (Apple Silicon, osx-arm64) while remaining buildable on any OS.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyVersion>1.17.2.0</AssemblyVersion>
    <FileVersion>1.17.2.0</FileVersion>
    <Version>1.17.2</Version>
    <!-- Avalonia bits -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Default runtime identifier when none is passed; macOS Apple Silicon. -->
    <RuntimeIdentifiers>osx-arm64;osx-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Drop the manifest reference entirely (it was Windows-specific). -->
  <PropertyGroup>
    <ApplicationManifest></ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.4" />
    <!-- Kept from the original project: enables `Deceive lol|lor|valorant|lion` direct launch. -->
    <PackageReference Include="System.CommandLine.DragonFruit" Version="0.4.0-alpha.22114.1" />
  </ItemGroup>
</Project>
